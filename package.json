{
  "name": "engineering-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @engineering-lab/api --filter @engineering-lab/web dev",
    "dev:api": "pnpm --filter @engineering-lab/api dev",
    "dev:web": "pnpm --filter @engineering-lab/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @engineering-lab/api test",
    "db:migrate": "pnpm --filter @engineering-lab/api prisma:migrate",
    "db:seed": "pnpm --filter @engineering-lab/api prisma:seed",
    "db:studio": "pnpm --filter @engineering-lab/api prisma:studio",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,css}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "nodemailer@<7.0.7": ">=7.0.7",
      "nodemailer@<8.0.4": ">=8.0.4",
      "vite@<=6.4.1": ">=6.4.2",
      "nodemailer@<=8.0.4": ">=8.0.5",
      "uuid@<11.1.1": ">=11.1.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "vite@<=6.4.2": ">=6.4.3",
      "nodemailer@<=8.0.8": ">=9.0.1",
      "vitest@<3.2.6": ">=3.2.6",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "nodemailer@<=9.0.0": ">=9.1.1",
      "vitest@>=2.1.0 <4.1.11": ">=4.1.11",
      "@vitest/mocker@>=2.1.0-beta.7 <4.1.12": ">=4.1.12",
      "nodemailer@>=3.0.0 <=10.0.9": ">=10.1.4",
      "nodemailer@>=3.0.0 <=10.0.12": ">=10.1.3",
      "nodemailer@>=6.9.16 <9.1.0": ">=9.1.0",
      "nodemailer@<10.0.2": ">=10.0.2",
      "tinypool@<=2.1.0": ">=2.1.1",
      "tinypool@<2.1.2": ">=2.1.2",
      "vite@<=6.4.3": ">=6.4.4",
      "zod@<4.6.6": ">=4.6.6",
      "minimatch@>=7.0.0 <11.0.1": ">=11.0.1",
      "undici@<6.0.0": ">=5.0.0"
    }
  }
}