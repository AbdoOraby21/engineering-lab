{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/.next/**",
      "use": "@vercel/fs-edgemiddle"
    },
    {
      "src": "*/api/**",
      "use": "Nodejs",
      "config": {
        "functionMemory": 1024,
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://engineering-lab-api.onrender.com/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://engineering-lab-api.onrender.com/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots.txt"
    }
  ],
  "publicAssets": [
    {
      "glob": "apps/web/out/**/*.{png,jpg,jpeg,webp,svg,js,css}",
      "category": "imagesAndFonts"
    }
  ]
}