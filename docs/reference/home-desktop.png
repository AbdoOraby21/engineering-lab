<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 120" width="160" height="120" role="img" aria-label="Engineering Lab logo" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4ADE80"/>
      <stop offset="1" stop-color="#16A34A"/>
    </linearGradient>
  </defs>
  <!-- orbit swoosh -->
  <path d="M8 88 C 20 110, 90 118, 140 70" fill="none" stroke="#F5F7FA" stroke-width="3" stroke-linecap="round" opacity="0.9"/>
  <path d="M30 20 C 70 -2, 130 8, 150 45" fill="none" stroke="#22C55E" stroke-width="3" stroke-linecap="round"/>
  <!-- gear teeth -->
  <circle cx="78" cy="60" r="46" fill="none" stroke="url(#g)" stroke-width="14" stroke-dasharray="11.5 9.5" />
  <!-- gear body -->
  <circle cx="78" cy="60" r="38" fill="#0B1F14" stroke="url(#g)" stroke-width="6"/>
  <circle cx="78" cy="60" r="30" fill="none" stroke="#22C55E" stroke-width="1.5" opacity="0.6"/>
  <!-- chip -->
  <rect x="58" y="40" width="40" height="40" rx="5" fill="#0B1F14" stroke="#F5F7FA" stroke-width="3"/>
  <rect x="67" y="49" width="22" height="22" rx="2" fill="none" stroke="#22C55E" stroke-width="3"/>
  <circle cx="78" cy="60" r="4" fill="#22C55E"/>
  <!-- chip pins -->
  <g stroke="#F5F7FA" stroke-width="3" stroke-linecap="round">
    <path d="M65 40v-7M78 40v-7M91 40v-7"/>
    <path d="M65 80v7M78 80v7M91 80v7"/>
    <path d="M58 47h-7M58 60h-7M58 73h-7"/>
    <path d="M98 47h7M98 60h7M98 73h7"/>
  </g>
</svg>
