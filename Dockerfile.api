FROM node:20-alpine AS builder

WORKDIR /app

# Prisma needs OpenSSL on Alpine; HUSKY=0 skips git hooks during install.
RUN apk add --no-cache openssl \
  && corepack enable \
  && corepack prepare pnpm@9.12.3 --activate
ENV HUSKY=0

# Workspace manifests first, so the dependency layer is cached.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/

# Dev dependencies are needed here (tsup, prisma) to build.
RUN pnpm install --frozen-lockfile --filter @engineering-lab/api...

# Source
COPY apps/api/tsconfig.json apps/api/tsup.config.ts apps/api/
COPY apps/api/src apps/api/src
COPY apps/api/prisma apps/api/prisma
COPY packages/shared/src packages/shared/src

# Generate Prisma client, then bundle the API into apps/api/dist
RUN pnpm --filter @engineering-lab/api prisma:generate \
  && pnpm --filter @engineering-lab/api build

# Production stage
FROM node:20-alpine

RUN apk add --no-cache openssl

WORKDIR /app

# The tsup bundle keeps dependencies external, so node_modules (with the
# generated Prisma client) must ship with it.
COPY --from=builder /app /app

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
  && chown -R appuser:appgroup /app

WORKDIR /app/apps/api

ENV NODE_ENV=production

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/api/v1/health || exit 1

EXPOSE 4000

USER appuser

CMD ["node", "dist/index.js"]
