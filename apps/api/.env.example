NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engineering_lab?schema=public

WEB_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Engineering Lab <no-reply@engineering-lab.local>

ADMIN_NAME=Engineering Lab Admin
ADMIN_EMAIL=admin@engineering-lab.local
ADMIN_PASSWORD=ChangeMe12345

LOG_LEVEL=info
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Image storage: "local" (files served from UPLOAD_DIR) or "cloudinary"
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=engineering-lab

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

DATASHEET_MAX_BYTES=15728640
REVIEWS_REQUIRE_PURCHASE=true
