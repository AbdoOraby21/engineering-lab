    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^18.1.3",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "papaparse": "^5.7.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sanitize-html": "^2.18.1",
