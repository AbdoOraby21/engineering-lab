    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
